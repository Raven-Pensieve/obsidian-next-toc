{
	"name": "next-toc",
	"version": "2.5.0",
	"description": "Floating panel displaying the current document's reading progress, table of contents, and navigation aids.",
	"main": "main.js",
	"scripts": {
		"dev": "node --env-file-if-exists=.env scripts/deploy.mjs link && node scripts/esbuild.config.mjs dev",
		"build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.config.mjs prod && node --env-file-if-exists=.env scripts/deploy.mjs copy",
		"lint": "eslint src/ styles/",
		"i18n:typesafe": "typesafe-i18n",
		"i18n:sync": "node scripts/sync-i18n.mjs",
		"test": "jest",
		"test:watch": "jest --watch"
	},
	"keywords": [
		"Obsidian Plugin",
		"Table of Contents",
		"Reading Progress"
	],
	"author": "RavenHogWarts",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=18.x"
	},
	"devDependencies": {
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.9.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@typescript-eslint/eslint-plugin": "8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"esbuild": "0.28.1",
		"eslint": "^10.4.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jest": "^30.4.2",
		"lucide-react": "^1.34.0",
		"obsidian": "^1.13.1",
		"ts-jest": "^29.4.10",
		"tslib": "2.8.1",
		"typesafe-i18n": "^5.27.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.61.0"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"radix-ui": "^1.4.3",
		"react": "^18.3.1",
		"react-circular-progressbar": "^2.2.0",
		"react-dom": "^18.3.1"
	}
}
